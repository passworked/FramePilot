name = "framepilot-telemetry"
main = "src/index.js"
compatibility_date = "2026-07-23"
workers_dev = true

[vars]
# Set this after the Cloudflare Tunnel hostname exists.
ORIGIN_URL = "https://origin-ingest.example.com"

# Never put ORIGIN_SECRET in this file. Configure it with:
# npx wrangler secret put ORIGIN_SECRET
